+    def move_pinned(self, panel_id, direction):
+        """Кнопки ↑/↓ в заголовке закреплённой панели — сдвиг в стеке.
 
-        # 1. Header
+        Заменяет перетаскивание мышью (drag-n-drop): в Tkinter
